{
  "expo": {
    "name": "Settler",
    "slug": "settler",
    "version": "1.3.0",
    "scheme": [
      "settler",
      "pocketbook"
    ],
    "platforms": [
      "ios",
      "android"
    ],
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Settler to use Face ID to unlock your financial records."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F3F5F3",
          "dark": {
            "image": "./assets/icon.png",
            "backgroundColor": "#172020"
          }
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Settler to listen while you dictate expense entries.",
          "speechRecognitionPermission": "Allow Settler to recognize your spoken expenses on this device.",
          "androidSpeechServicePackages": [
            "com.google.android.as"
          ]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Settler to photograph receipts for expense drafts.",
          "microphonePermission": "Allow Settler to listen while you dictate expense entries.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F3F5F3"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.razatechlabs.settler",
      "icon": "./assets/icon.png",
      "buildNumber": "5"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#063E35"
      },
      "package": "com.razatechlabs.settler",
      "versionCode": 5,
      "softwareKeyboardLayoutMode": "resize",
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "icon": "./assets/icon.png"
    }
  }
}
